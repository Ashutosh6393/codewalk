{
  "extends": "@codewalk/typescript-config/base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src/**/*.ts", "harness/**/*.ts"],
  // `__fixtures__/alias-repo` is a synthetic repo tree read off disk by the graph
